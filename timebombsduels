----------------------------------------------------------------
local NOTIF_WIDTH  = 232
local NOTIF_MARGIN = 14
local NOTIF_TOP    = 90   -- ← "a lil lowered" (was 14)

local notifHolder = Instance.new("Frame")
notifHolder.Name                   = "Notifications"
notifHolder.AnchorPoint            = Vector2.new(1, 0)                        -- anchor to the right edge
notifHolder.Position               = UDim2.new(1, -NOTIF_MARGIN, 0, NOTIF_TOP) -- top-right corner
