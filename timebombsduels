local notifOrder = 0

local function notify(text, isOn)
	notifOrder += 1

	local slot = Instance.new("Frame")
	slot.Size                   = UDim2.new(1, 0, 0, 42)
	slot.BackgroundTransparency = 1
	slot.LayoutOrder            = notifOrder
	slot.Parent                 = notifHolder

	local card = Instance.new("CanvasGroup")
	card.Size                   = UDim2.new(1, 0, 1, 0)
	card.Position               = UDim2.new(0, 260, 0, 0)   -- starts off-screen to the RIGHT
	card.BackgroundColor3       = Color3.fromRGB(24, 24, 31)
	card.BackgroundTransparency = 0.05
	card.GroupTransparency      = 1
	card.Parent                 = slot

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 12)
	c.Parent = card

	local s = Instance.new("UIStroke")
	s.Color        = Color3.fromRGB(70, 70, 88)
	s.Thickness    = 1
	s.Transparency = 0.45
	s.Parent       = card

	local dot = Instance.new("Frame")
	dot.Size             = UDim2.new(0, 8, 0, 8)
	dot.Position         = UDim2.new(0, 14, 0.5, -4)
	dot.BorderSizePixel  = 0
	dot.BackgroundColor3 = isOn and Color3.fromRGB(0, 220, 130) or Color3.fromRGB(255, 90, 90)
	dot.Parent           = card

	local dc = Instance.new("UICorner")
	dc.CornerRadius = UDim.new(1, 0)
	dc.Parent = dot

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position              = UDim2.new(0, 32, 0, 0)
	label.Size                  = UDim2.new(1, -44, 1, 0)
	label.Font                  = Enum.Font.GothamMedium
	label.TextSize              = 13
	label.TextColor3            = Color3.fromRGB(240, 240, 246)
	label.TextXAlignment        = Enum.TextXAlignment.Left
	label.Text                  = text
	label.Parent                = card

	-- slide in from the right + fade in
	TweenService:Create(card, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position          = UDim2.new(0, 0, 0, 0),
		GroupTransparency = 0,
	}):Play()

	-- slide back out to the right + fade out
	task.delay(2.2, function()
		local out = TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position          = UDim2.new(0, 260, 0, 0),
			GroupTransparency = 1,
		})
		out:Play()
		out.Completed:Wait()
		slot:Destroy()
	end)
end

