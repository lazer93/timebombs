--==================================================
-- CHAM / HEALTH SYSTEM
--==================================================

local Chams = {}
local HealthDisplays = {}

local function RemovePlayerVisuals(player)

	if Chams[player] then
		Chams[player]:Destroy()
		Chams[player] = nil
	end

	if HealthDisplays[player] then
		HealthDisplays[player]:Destroy()
		HealthDisplays[player] = nil
	end
end

local function CreateChams(player)

	if player == LocalPlayer then
		return
	end

	if not Settings.Chams then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local highlight = Chams[player]

	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "FOVMB_Chams"
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.45
		highlight.OutlineTransparency = 0
		highlight.Parent = character

		Chams[player] = highlight
	else
		highlight.Parent = character
	end

	highlight.FillColor = Settings.GuiColor
	highlight.OutlineColor = Settings.GuiColor
end

local function CreateHealthDisplay(player)

	if player == LocalPlayer then
		return
	end

	if not Settings.Health then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local head = character:FindFirstChild("Head")
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not head or not humanoid then
		return
	end

	if HealthDisplays[player] then
		HealthDisplays[player].Parent = head
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "FOVMB_Health"
	billboard.Size = UDim2.new(0, 120, 0, 35)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local healthText = Instance.new("TextLabel")
	healthText.Size = UDim2.new(1, 0, 1, 0)
	healthText.BackgroundTransparency = 1
	healthText.TextColor3 = Color3.fromRGB(255, 255, 255)
	healthText.TextStrokeTransparency = 0
	healthText.TextStrokeColor3 = Color3.new(0, 0, 0)
	healthText.Font = Enum.Font.GothamBold
	healthText.TextSize = 14
	healthText.Parent = billboard

	HealthDisplays[player] = billboard

	local function UpdateHealth()

		if not billboard.Parent then
			return
		end

		local current = math.max(0, math.floor(humanoid.Health))
		local maximum = math.max(1, math.floor(humanoid.MaxHealth))

		healthText.Text =
			player.DisplayName
			.. "  |  "
			.. current
			.. "/"
			.. maximum

		if current / maximum > 0.6 then
			healthText.TextColor3 =
				Color3.fromRGB(90, 255, 110)
		elseif current / maximum > 0.3 then
			healthText.TextColor3 =
				Color3.fromRGB(255, 210, 70)
		else
			healthText.TextColor3 =
				Color3.fromRGB(255, 75, 75)
		end
	end

	UpdateHealth()

	humanoid.HealthChanged:Connect(UpdateHealth)
end

local function UpdateESP()

	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer then

			if Settings.Chams then
				CreateChams(player)
			else
				if Chams[player] then
					Chams[player]:Destroy()
					Chams[player] = nil
				end
			end

			if Settings.Health then
				CreateHealthDisplay(player)
			else
				if HealthDisplays[player] then
					HealthDisplays[player]:Destroy()
					HealthDisplays[player] = nil
				end
			end
		end
	end
end

