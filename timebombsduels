local MULTIPLIER  = 10        -- total taps per real tap
local REPLAY_GAP  = 0.012     -- seconds between the extra taps
local PRESS_GAP   = 0.006     -- Begin → End gap for each simulated tap
local DEBOUNCE    = 0.05      -- ignore the same physical tap firing twice

local enabled = false

